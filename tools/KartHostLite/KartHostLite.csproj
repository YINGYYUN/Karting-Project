<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 全部用代码建界面、不用设计器，关掉"自定义控件属性需可被设计器序列化"这条规则 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>KartHostLite</AssemblyName>
    <!-- ★ RootNamespace 保持 KartHost：从队友工程搬来的 Protocol/Link/WavePanel 等
         文件里写的是 namespace KartHost; 这样搬过来一字不改 -->
    <RootNamespace>KartHost</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Product>卡丁快跑 轻量上位机</Product>
    <AssemblyTitle>KartHostLite</AssemblyTitle>
  </PropertyGroup>

  <!-- ★ 2026-10-23 起**引入** System.IO.Ports —— 只为一件事：路表"灌表"走 DAP 虚拟串口
       （协议与车端 route_link.c 对应，见 RouteLink.cs）。
       原来那条"本工程不走串口"的约定就此作废：WiFi 下行是定长 15 B，搬不动 32 KB 的镜像。
       ⚠ 10.0.12 是本机 NuGet 缓存里已有的版本（含 net9.0 资产）；换版本要先能联网还原。 -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

</Project>
